name: Quality

on:
    push:
    pull_request:
    workflow_dispatch:

permissions:
    contents: read

jobs:
    quality:
        name: C++ on ${{ matrix.os }}
        runs-on: ${{ matrix.os }}
        timeout-minutes: 15
        strategy:
            fail-fast: false
            matrix:
                os: [ubuntu-latest, windows-latest]

        steps:
            - name: Check out repository
              uses: actions/checkout@v6

            - name: Set up Python repository tooling
              uses: actions/setup-python@v6
              with:
                  python-version: "3.12"

            - name: Set up project
              run: python scripts/project.py setup

            - name: Run checks
              run: python scripts/project.py check
