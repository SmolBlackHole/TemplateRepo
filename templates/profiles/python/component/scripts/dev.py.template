"""Set up and verify the Python project."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VENV = ROOT / ".venv"


def _venv_python() -> Path:
    return VENV / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def _run(command: Sequence[str]) -> None:
    print(f"> {' '.join(command)}", flush=True)
    subprocess.run(command, cwd=ROOT, check=True)


def setup() -> None:
    if sys.version_info < (3, 12):
        raise SystemExit("Python 3.12 or newer is required by this profile.")
    if not _venv_python().is_file():
        _run((sys.executable, "-m", "venv", str(VENV)))
    _run((str(_venv_python()), "-m", "pip", "install", "-e", ".[dev]"))


def check() -> None:
    python = _venv_python()
    if not python.is_file():
        raise SystemExit("Run scripts/setup.ps1 or scripts/setup.sh first.")
    _run((str(python), "-m", "ruff", "check", "src", "tests"))
    _run((str(python), "-m", "ruff", "format", "--check", "src", "tests"))
    _run((str(python), "-m", "mypy"))
    _run((str(python), "-m", "pyright"))
    _run((str(python), "-m", "pytest"))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("setup", "check"))
    command = parser.parse_args().command
    setup() if command == "setup" else check()


if __name__ == "__main__":
    main()
